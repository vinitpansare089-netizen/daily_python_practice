   "source": [
    "\"\"\"\n",
    "Two Sum problem of hashmap\n",
    "\"\"\"\n",
    "\n",
    "nums = [3,2,4]\n",
    "target = 6\n",
    "\n",
    "hashmap = {}\n",
    "\n",
    "for i, num in enumerate(nums):\n",
    "    need = target - num\n",
    "    if num in hashmap:\n",
    "        print([hashmap[need], i])\n",
    "        break\n",
    "\n",
    "    hashmap[num] = i\n",
    "    \n",
    "print([hashmap[need], i])"
   ]
  }
 ],
