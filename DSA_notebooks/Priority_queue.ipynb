    "\"\"\"\n",
    "Priority queue\n",
    "\"\"\"\n",
    "\n",
    "import heapq\n",
    "\n",
    "pq = []\n",
    "\n",
    "heapq.heappush(pq,5)\n",
    "heapq.heappush(pq,2)\n",
    "heapq.heappush(pq,8)\n",
    "heapq.heappush(pq,1)\n",
    "\n",
    "while pq:\n",
    "    print(heapq.heappop(pq))"
   ]
  }
