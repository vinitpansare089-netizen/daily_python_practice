   "source": [
    "nums = [1,2,3,4,5,6]\n",
    "\n",
    "left = 0\n",
    "right = len(nums) - 1\n",
    "\n",
    "while left < right:\n",
    "    nums[left] = nums[right]\n",
    "    nums[right] = nums[left] \n",
    "    left += 1\n",
    "\n",
    "    right -= 1\n",
    "\n",
    "print(nums)\n"
   ]
  }
 ],
