   "source": [
    "accounts = [[1,2,3],[3,2,1]]\n",
    "\n",
    "maximum = 0\n",
    "\n",
    "for acc in accounts:\n",
    "    wealth = sum(acc)\n",
    "\n",
    "    if wealth > maximum:\n",
    "        maximum = wealth\n",
    "\n",
    "    print(maximum)"
   ]
