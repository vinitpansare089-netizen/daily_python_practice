   "source": [
    "nums = [2, 1, 2, 4, 3]\n",
    "\n",
    "nums.sort()\n",
    "print(nums)\n",
    "\n",
    "right = len(nums) - 1\n",
    "\n",
    "while right >= 2:\n",
    "    a = nums[right - 2]\n",
    "    b = nums[right - 1]\n",
    "    c = nums[right]\n",
    "\n",
    "    if a + b > c:\n",
    "        print(a + b + c)\n",
    "\n",
    "    right -= 1\n",
    "\n",
    "print(False)\n"
   ]
  }
 ],
