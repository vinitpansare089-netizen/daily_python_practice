   "source": [
    "head = [1,2,3,4,5]\n",
    "\n",
    "prev = None\n",
    "\n",
    "current = head\n",
    "\n",
    "while current:\n",
    "    next_node = current.next\n",
    "    current.next = prev\n",
    "    prev = current\n",
    "    current = next_node\n",
    "\n",
    "print(prev)"
   ]
