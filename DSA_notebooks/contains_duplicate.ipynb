    "\n",
    "seen = set()###TO ceate a set not dict\n",
    "\n",
    "def hashset(nums):\n",
    "    for num in nums:\n",
    "        \n",
    "        if num in seen:\n",
    "            return True\n",
    "    \n",
    "        else:\n",
    "            seen.add(num)\n",
    "\n",
    "    return False\n",
    "\n",
    "print(hashset(nums = [1,2,3,0]))\n"
   ]
  }
