   "source": [
    "\"\"\"\n",
    "Frequency counting\n",
    "\"\"\"\n",
    "\n",
    "s = \"tree\"\n",
    "\n",
    "count = {}\n",
    "\n",
    "for char in s:\n",
    "    count[char] = count.get(char ,0) + 1\n",
    "\n",
    "result = ''\n",
    "\n",
    "for char in sorted(count, key=count.get, reverse=True):\n",
    "    result += char * count[char]\n",
    "\n",
    "print(result)\n"
   ]
