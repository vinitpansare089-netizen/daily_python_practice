    "\"\"\"\n",
    "Happy number\n",
    "\"\"\"\n",
    "n = 19\n",
    "\n",
    "seen = set()\n",
    "\n",
    "while n != 1:\n",
    "\n",
    "    if n in seen:\n",
    "        print(False)\n",
    "\n",
    "    seen.add(n)\n",
    "\n",
    "    total = 0\n",
    "\n",
    "    while n > 0:\n",
    "        digit = n % 10\n",
    "        total += digit * digit\n",
    "        n = n // 10\n",
    "\n",
    "    n = total\n",
    "        \n",
    "\n",
    "print(True)\n",
    "    "
   ]
  }
