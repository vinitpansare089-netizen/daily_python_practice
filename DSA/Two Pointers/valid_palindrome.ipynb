    "Valid Palindrome\n",
    "\"\"\"\n",
    "\n",
    "s = \"A man, a plan, a canal: Panama\"\n",
    "\n",
    "s = [char.lower() for char in s if char .isalnum()]\n",
    "\n",
    "s =''.join(s)\n",
    "print(s)\n",
    "\n",
    "left = 0\n",
    "right = len(s) - 1\n",
    "\n",
    "while left < right:\n",
    "\n",
    "    if s[left] != s[right]:\n",
    "        print(False)\n",
    "\n",
    "    else:\n",
    "        print(True)\n",
    "\n",
    "print(True)\n",
    "\n",
