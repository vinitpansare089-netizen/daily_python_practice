    "Is Subsequence\n",
    "\"\"\"\n",
    "s = 'abc'\n",
    "t = 'ahbgdc'\n",
    "\n",
    "i = 0\n",
    "j = 0\n",
    "\n",
    "while i < len(s) and j < len(t):\n",
    "\n",
    "    if s[i] == t[j]:\n",
    "        i += 1\n",
    "\n",
    "    j += 1\n",
    "\n",
    "print(i == len(s))"
