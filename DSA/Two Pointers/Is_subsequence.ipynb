    "\"\"\"\n",
    "Is Subsequence\n",
    "\"\"\"\n",
    "\n",
    "s = 'abc'\n",
    "t = 'ahbgdc'\n",
    "\n",
    "i = 0\n",
    "j = 0\n",
    "\n",
    "for i in range(s):\n",
    "    for j in range(t):\n",
    "        if s[i] == t[j]:\n",
    "            i += 1\n",
    "            j += 1\n",
    "\n",
    "        elif s[i] != s[j]:\n",
    "            j += 1\n",
    "\n",
    "        else:\n",
    "            print(True)"
