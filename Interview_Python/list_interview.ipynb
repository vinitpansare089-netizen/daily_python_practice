    "max,min number \n",
    "\"\"\"\n",
    "\n",
    "def max(nums: list):\n",
    "\n",
    "    max = 0\n",
    "\n",
    "    for i in range(len(nums)):\n",
    "        if nums[i] > max:\n",
    "            max = nums[i]\n",
    "\n",
    "    return max\n",
    "\n",
    "max([2, 5, 34, 23, 87])\n"
