    "\"\"\"\n",
    "Recursive function for sum\n",
    "\"\"\"\n",
    "\n",
    "def recursive_sum(n):\n",
    "\n",
    "    if n == 0:\n",
    "        return 0\n",
    "\n",
    "    return n + recursive_sum(n - 1)\n",
    "\n",
    "print(recursive_sum(5))\n"
   ]
  }
 ],
