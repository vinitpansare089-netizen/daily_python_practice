   "source": [
    "\"\"\"\n",
    "SwapCase program\n",
    "\"\"\"\n",
    "\n",
    "def to_case(s):\n",
    "\n",
    "    for char in s:\n",
    "\n",
    "        if char.islower():\n",
    "            result += char.upper()\n",
    "        else:\n",
    "            result += char.lower()\n",
    "\n",
    "    return result\n",
    "\n",
    "s = \"vInEEt\"\n",
    "result = to_case(s)\n",
    "print(result)"
   ]
  }
