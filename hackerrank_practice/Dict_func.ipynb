   "source": [
    "from collections import defaultdict\n",
    "\n",
    "def group_numbers(nums):\n",
    "    d = defaultdict(list)\n",
    "\n",
    "    for num in nums:\n",
    "        key = 'div_by_3' if num % 3 == 0 else 'not_div_by_3'\n",
    "        d[key].append(num)\n",
    "\n",
    "        return dict(d)\n",
    "    \n",
    "nums = [12, 25, 30, 7, 18]\n",
    "print(group_numbers(nums))"
   ]
  }
